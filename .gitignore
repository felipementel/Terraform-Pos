# Credenciais e variáveis sensíveis
*.tfvars
!*.tfvars.example

# Arquivos locais de automação
scripts/*.local.ps1


# Diretório de plugins e módulos do Terraform
.terraform/

# Arquivos de estado
*.tfstate
*.tfstate.backup

# Lock file (opcional — remova o ! se quiser versionar)
.terraform.lock.hcl

# Logs de crash
crash.log
crash.*.log

# Arquivos de override
override.tf
override.tf.json
*_override.tf
*_override.tf.json
